# Which tenant brand loads by default. See src/brand/brands/index.js
VITE_DEFAULT_BRAND=cardflo

# Show the brand switcher in the top bar. Turn this off for a client demo so
# the portal looks like it only ever belonged to them.
VITE_SHOW_BRAND_SWITCHER=true

# Point at a live API when the demo graduates to real data.
# Leave blank to keep using the deterministic mock dataset in src/data.
VITE_API_BASE_URL=
